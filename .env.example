# Configuracion general del Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Apache Cassandra (Clientes)
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=facturacion_clientes
CASSANDRA_DC=datacenter1

# MongoDB (Productos e Imagenes con GridFS - puerto 27018 en host para evitar conflicto con mongod local en 27017)
MONGO_HOST=localhost
MONGO_PORT=27018
MONGO_DB=facturacion_productos
MONGO_USER=CAMBIAR_USUARIO_MONGO
MONGO_PASSWORD=CAMBIAR_PASSWORD_MONGO
MONGO_AUTH_SOURCE=admin

# MySQL (Facturacion Transaccional y Outbox)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=facturacion_transaccional
MYSQL_USER=CAMBIAR_USUARIO_MYSQL
MYSQL_PASSWORD=CAMBIAR_PASSWORD_MYSQL
MYSQL_ROOT_PASSWORD=CAMBIAR_PASSWORD_ROOT_MYSQL

# Apache Druid (Registro Analitico)
DRUID_ROUTER_URL=http://localhost:8888
DRUID_OVERLORD_URL=http://localhost:8081
DRUID_DATASOURCE=facturas_analiticas
DRUID_META_USER=druid
DRUID_META_PASSWORD=CAMBIAR_PASSWORD_DRUID_META
OUTBOX_POLL_INTERVAL_SECONDS=10

# Frontend
VITE_API_BASE_URL=http://localhost:8000
