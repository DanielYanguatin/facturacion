# Configuracion compartida de servicios Apache Druid 30.0.0 (perfil ligero micro-quickstart)
DRUID_SINGLE_NODE_CONF=micro-quickstart

# ZooKeeper interno para coordinacion de Druid
ZOOKEEPER=druid-zookeeper

# Extensiones requeridas (incluye metadatos PostgreSQL propio de Druid)
druid_extensions_loadList=["druid-hdfs-storage", "druid-datasketches", "druid-multi-stage-query", "postgresql-metadata-storage"]

# Almacen de metadatos interno de Druid (PostgreSQL dedicado)
druid_metadata_storage_type=postgresql
druid_metadata_storage_connector_connectURI=jdbc:postgresql://druid-postgres:5432/druid

# Deep storage local compartido entre coordinator, historical y middleManager
druid_storage_type=local
druid_storage_storageDirectory=/opt/shared/druid/segments

# Logs de tareas de indexacion
druid_indexer_logs_type=file
druid_indexer_logs_directory=/opt/shared/druid/indexing-logs
